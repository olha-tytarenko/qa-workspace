{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(uv run --no-sync ruff format --check .)",
      "Bash(uv run --no-sync ruff check .)",
      "Bash(uv run --no-sync mypy)",
      "Bash(uv run --no-sync pytest)",
      "Bash(uv run --no-sync pytest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
