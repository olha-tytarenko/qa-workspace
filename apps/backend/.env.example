# Documents the backend's environment variables. Never commit real environment files.
#
# Docker Compose is the supported path, including for the database integration
# tests: compose.yaml sets these variables for you (with host `db`, not
# `localhost`). Copying this file to `.env` only configures the application
# (`DATABASE_URL`); it does NOT configure pytest. `TEST_DATABASE_URL` is read from
# the process environment only, so running pytest on the host requires exporting
# it explicitly.

# Development database (async driver required).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qa_workspace

# Test database. The database name MUST end in `_test` and differ from DATABASE_URL;
# the test suite refuses to run otherwise. The suite drops and recreates it once
# per session, so run one test session at a time.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qa_workspace_test
